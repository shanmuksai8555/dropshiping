# Copy to .env.local for local dev (never commit real values). On Vercel, set these in
# Project > Settings > Environment Variables. None of these use the NEXT_PUBLIC_ prefix, so none are
# exposed to the browser. Every group is optional: leave it unset and that feature shows a clear
# "not configured" state instead of failing.

# ---- WooCommerce (catalog + orders) -----------------------------------------------------------
# Unset = the built-in, clearly labelled SAMPLE catalog is used.
# LocalWP (Phase 1): http://your-site.local  (or http://localhost:10003). Oracle (Phase 2): https://shop.example.com
WOO_URL=
# WooCommerce > Settings > Advanced > REST API > Add key, permissions Read/Write
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# Optional override: basic | query | oauth1. Default: basic for https, oauth1 for http on localhost/*.local.
WOO_AUTH_MODE=
# Secret you type into each WooCommerce webhook (order.created -> /api/dropdash-sync, product.* -> /api/revalidate)
WOO_WEBHOOK_SECRET=

# ---- Razorpay (checkout) ----------------------------------------------------------------------
# Dashboard > Account & Settings > API Keys. Use rzp_test_... keys until you go live.
# The key id is sent to the browser by /api/checkout/create-order (that is by design); the secret never is.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > Add: URL https://<site>/api/razorpay/webhook, event payment.captured, this secret
RAZORPAY_WEBHOOK_SECRET=

# ---- Google Sheets (WhatsApp VIP leads) -------------------------------------------------------
# Service account in Google Cloud (Sheets API enabled). Share the sheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key. Keep the \n sequences; they are converted to newlines.
GOOGLE_PRIVATE_KEY=
# The id in https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Optional, default Leads!A:E  (columns: timestamp, name, phone, interest, source)
GOOGLE_SHEET_RANGE=

# ---- Dropdash (fulfilment) --------------------------------------------------------------------
# No public Dropdash API was found. Leave unset: orders are mapped and logged, and you use the CSV export.
# Only set these once Dropdash gives you an API endpoint and key (see lib/dropdash.ts TODO).
DROPDASH_API_URL=
DROPDASH_API_KEY=

# ---- Admin / ops ------------------------------------------------------------------------------
# Long random string. Protects GET /api/admin/orders.csv   (openssl rand -hex 32)
ADMIN_TOKEN=
# Long random string for POST /api/revalidate?secret=...
REVALIDATE_SECRET=
# Optional display name passed to Razorpay Checkout (default "Lumen Market")
STORE_NAME=
